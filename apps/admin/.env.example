# ─────────────────────────────────────────────────────────────
# Admin dashboard environment
#
# NOTE: NEXT_PUBLIC_* variables are inlined into the client bundle
# at BUILD time. Changing them requires a rebuild, not just a restart.
# ─────────────────────────────────────────────────────────────

# Base URL of the Yala Haji API, including the version prefix.
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000/api/v1

# Used for the "View storefront" link and product preview links.
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
