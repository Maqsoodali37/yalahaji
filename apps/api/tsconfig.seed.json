{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2021",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist-seed",
    "rootDir": ".",
    "resolveJsonModule": true
  },
  // seed.ts imports src/settings/config-catalogue, so rootDir must span both
  // prisma/ and src/. Output is therefore dist-seed/prisma/seed.js — the
  // entrypoint depends on that path.
  "include": ["prisma/seed.ts", "src/settings/config-catalogue.ts"]
}
