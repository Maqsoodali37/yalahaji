# ═══════════════════════════════════════════════════════════════
#  Yala Haji — single environment file for ALL apps
#  (api · storefront · admin · infra)
#
#  Copy to .env and fill in the secrets:   cp .env.example .env
#  There are no per-app .env files. apps/api reads this file via
#  ConfigModule envFilePath '../../.env'; the Next.js apps receive
#  their NEXT_PUBLIC_* values as build args from docker-compose.yml.
#
#  Values below are the LOCAL DEVELOPMENT defaults (everything on
#  localhost). Comments marked  # docker:  give the value to use when
#  running under docker compose, where services reach each other by
#  container name on the yalahaji-net bridge.
# ═══════════════════════════════════════════════════════════════

# ── General ──────────────────────────────────────────────────
NODE_ENV=development                      # docker: production

# Swagger UI at /api/docs. Set to false to hide it in production.
SWAGGER_ENABLED=true                      # docker: false

# ── Ports ────────────────────────────────────────────────────
#  *_PORT      = port INSIDE the container
#  *_HOST_PORT = port published on the host / VPS
#  Change only the *_HOST_PORT values if something already occupies
#  that port on your machine.
MYSQL_PORT=3306
MYSQL_HOST_PORT=3306

REDIS_PORT=6379
REDIS_HOST_PORT=6379

MEILI_PORT=7700
MEILI_HOST_PORT=7700

MINIO_PORT=9000
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_CONSOLE_HOST_PORT=9001

API_PORT=4000
API_HOST_PORT=4000

STOREFRONT_PORT=3000
STOREFRONT_HOST_PORT=3000

ADMIN_PORT=3001
ADMIN_HOST_PORT=3001

# ── MySQL ────────────────────────────────────────────────────
MYSQL_HOST=localhost                      # docker: mysql
MYSQL_DATABASE=yalahaji
MYSQL_USER=yalahaji_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# URL-encoded copy of MYSQL_PASSWORD. Required if the password contains
# characters reserved in a URI (& ? * / : @ #). If yours is alphanumeric,
# just set this to the same value.
MYSQL_ENCODED_PASS=change-me

DATABASE_URL=mysql://${MYSQL_USER}:${MYSQL_ENCODED_PASS}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost                      # docker: redis
REDIS_PASSWORD=

# ── MeiliSearch ──────────────────────────────────────────────
MEILI_ENV=development                     # docker: production
MEILI_MASTER_KEY=change-me                # openssl rand -hex 32
MEILISEARCH_URL=http://localhost:7700     # docker: http://meilisearch:7700
MEILISEARCH_KEY=change-me                 # same value as MEILI_MASTER_KEY

# ── MinIO (object storage) ───────────────────────────────────
MINIO_ENDPOINT=localhost                  # docker: minio
MINIO_USE_SSL=false
MINIO_ROOT_USER=yalahaji_minio
MINIO_ROOT_PASSWORD=change-me
MINIO_ACCESS_KEY=yalahaji_minio           # same as MINIO_ROOT_USER
MINIO_SECRET_KEY=change-me                # same as MINIO_ROOT_PASSWORD
MINIO_BUCKET=yalahaji
MINIO_PUBLIC_URL=http://localhost:9000/yalahaji   # docker: your CDN origin

# ── Auth ─────────────────────────────────────────────────────
# Customer / storefront tokens (bearer).
JWT_SECRET=change-me                      # openssl rand -base64 48
JWT_EXPIRES_IN=7d

# Admin panel. MUST differ from JWT_SECRET — that separation is what stops a
# customer token from ever authenticating against a staff route.
ADMIN_JWT_SECRET=change-me                # openssl rand -base64 48
ADMIN_JWT_EXPIRES_IN=8h

# Cookie scope for the admin session, e.g. ".yalahaji.com" so the admin
# subdomain can authenticate against the api subdomain. Blank in local dev.
COOKIE_DOMAIN=

# ── Public URLs ──────────────────────────────────────────────
# CORS allow-list on the API.
STOREFRONT_URL=http://localhost:3000      # docker: https://yalahaji.com
ADMIN_URL=http://localhost:3001           # docker: https://yh-admin.yalahaji.com

# NEXT_PUBLIC_* are inlined into the client bundle at BUILD time —
# changing them requires `docker compose build`, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1        # docker: https://api.yalahaji.com/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000              # docker: https://yalahaji.com
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000/api/v1  # docker: https://api.yalahaji.com/api/v1
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000        # docker: https://yalahaji.com
NEXT_PUBLIC_WHATSAPP_NUMBER=+920000000000

# Optional — enables Facebook Insights on shared links. Leave blank to omit.
NEXT_PUBLIC_FACEBOOK_APP_ID=

# ── Prebuilt images (docker-compose.prod.yml) ────────────────
# GitHub org/user that owns the ghcr.io images.
GITHUB_OWNER=
